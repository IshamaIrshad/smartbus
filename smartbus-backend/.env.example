# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored and must never be committed.

DB_URL=jdbc:mysql://localhost:3306/smartbus_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Must be a Base64 string. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_base64_string
